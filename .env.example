# GEMINI_API_KEY: Optional AI runtime key (automatically injected in AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of emails granted initial system_admin access.
ADMIN_EMAILS=""

# Optional Email Notification Provider (if omitted, email logs record provider_unconfigured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Optional Web Push VAPID keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
